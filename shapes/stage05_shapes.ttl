@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix s05:   <https://fandaws.com/ontology/bco/shapes/stage05#> .

# The Stage 05 checks that SHACL can state (docs/standards/stage-05-ontology.md,
# section 5): S05-C1, C2, C3, C5, C6 and C7. The checks that need the tranche
# record or a module boundary -- S05-T1, C1's module half, C3's declaration of
# ex:enablesProcess, C4, C8, C9 -- are in tests/test_formalization.py; the
# reasoner gates S05-D and S05-D2 are tools/ontology/reason.py.
#
# WHAT A K1 CLASS IS HERE
#
# A class in https://fandaws.com/ontology/bco# that is bco:BusinessCapability
# or reaches it through rdfs:subClassOf. The namespace is written whole, as
# wellformedness_shapes.ttl explains, and tests/test_namespace.py holds it to
# AUTHORED_NAMESPACES. Two rules (C1) look at the classes that should be K1
# and are not.
#
# The data graph is the module, the vocabulary and the vendored extracts, so
# an index member's declaration and ancestry are walked through the BPO and
# CCO extracts. The fixture (stage05_bad_examples.ttl) is loaded alone, and
# states the small ancestry its cases need.
#
# Every constraint carries its own message; tests/test_formalization.py lists
# them and requires each to fire on its own case.

s05:prefixes
    a owl:Ontology ;
    sh:declare
        [ sh:prefix "rdfs" ; sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI ] ,
        [ sh:prefix "owl"  ; sh:namespace "http://www.w3.org/2002/07/owl#"^^xsd:anyURI ] ,
        [ sh:prefix "skos" ; sh:namespace "http://www.w3.org/2004/02/skos/core#"^^xsd:anyURI ] ,
        [ sh:prefix "obo"  ; sh:namespace "http://purl.obolibrary.org/obo/"^^xsd:anyURI ] ,
        [ sh:prefix "cco"  ; sh:namespace "https://www.commoncoreontologies.org/"^^xsd:anyURI ] ,
        [ sh:prefix "ex"   ; sh:namespace "https://fandaws.com/ontology/bpo#"^^xsd:anyURI ] ,
        [ sh:prefix "bco"  ; sh:namespace "https://fandaws.com/ontology/bco#"^^xsd:anyURI ] .


# ---------------------------------------------------------------------
# S05-C1 (CAP-01, K1 part; standard S4): what should be K1 is
# ---------------------------------------------------------------------

s05:ShouldBeK1Shape
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:prefixes s05:prefixes ;
        sh:select """SELECT ?this WHERE {
          ?this a owl:Class .
          FILTER(STRSTARTS(STR(?this), "https://fandaws.com/ontology/bco#"))
          FILTER NOT EXISTS { ?this rdfs:subClassOf* bco:BusinessCapability }
        }""" ] ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "S05-C1: a BCO class with a realization index is not under bco:BusinessCapability (CAP-01)." ;
        sh:prefixes s05:prefixes ;
        sh:select """SELECT $this WHERE {
          $this ex:enablesProcess ?member . }""" ] ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "S05-C1: a BCO class under Organization Capability is not under bco:BusinessCapability; an admitted class is never staged (standard S4)." ;
        sh:prefixes s05:prefixes ;
        sh:select """SELECT $this WHERE {
          $this rdfs:subClassOf+ cco:ont00000568 . }""" ] .


# ---------------------------------------------------------------------
# K1 classes
# ---------------------------------------------------------------------

s05:K1ClassShape
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:prefixes s05:prefixes ;
        sh:select """SELECT ?this WHERE {
          ?this a owl:Class .
          FILTER(STRSTARTS(STR(?this), "https://fandaws.com/ontology/bco#"))
          ?this rdfs:subClassOf* bco:BusinessCapability .
        }""" ] ;

    # S05-C2, CAP-02: the existential misreading of a capability.
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "S05-C2: a capability class has a some restriction on has realization (obo:BFO_0000054), which would say every bearer has been realized (CAP-02)." ;
        sh:prefixes s05:prefixes ;
        sh:select """SELECT $this WHERE {
          $this rdfs:subClassOf ?r .
          ?r owl:onProperty obo:BFO_0000054 ; owl:someValuesFrom ?filler . }""" ] ;

    # S05-C3, CAP-03: the realization index.
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "S05-C3: a specific capability class has no realization index; every K1 class except the parent carries one or more ex:enablesProcess (CAP-03)." ;
        sh:prefixes s05:prefixes ;
        sh:select """SELECT $this WHERE {
          FILTER($this != bco:BusinessCapability)
          FILTER NOT EXISTS { $this ex:enablesProcess ?member } }""" ] ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "S05-C3: a realization-index member is not declared as a class in the vendored extracts (Gate B)." ;
        sh:prefixes s05:prefixes ;
        sh:select """SELECT $this ?member WHERE {
          $this ex:enablesProcess ?member .
          FILTER NOT EXISTS { ?member a owl:Class } }""" ] ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "S05-C3: a realization-index member does not reach Planned Act (cco:ont00000228) through rdfs:subClassOf (CAP-03)." ;
        sh:prefixes s05:prefixes ;
        sh:select """SELECT $this ?member WHERE {
          $this ex:enablesProcess ?member .
          ?member a owl:Class .
          FILTER NOT EXISTS { ?member rdfs:subClassOf* cco:ont00000228 } }""" ] ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "S05-C3: a realization-index member is capability-typed: it is under Organization Capability (cco:ont00000568), not an act (CAP-03)." ;
        sh:prefixes s05:prefixes ;
        sh:select """SELECT $this ?member WHERE {
          $this ex:enablesProcess ?member .
          ?member rdfs:subClassOf* cco:ont00000568 . }""" ] ;

    # S05-C5, CAP-07: a warning, as the specification grades it.
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Warning ;
        sh:message "S05-C5: a capability class's definition uses a deontic term (authoriz-, licen-, mandat-, responsib-, assign-, permit-; CAP-07)." ;
        sh:prefixes s05:prefixes ;
        sh:select """SELECT $this WHERE {
          $this skos:definition ?text .
          FILTER(REGEX(STR(?text), "authoriz|licen[cs]|mandat|responsib|assign|permit", "i")) }""" ] ;

    # S05-C6, CAP-09: no record mechanism exists, so any placement is unrecorded.
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "S05-C6: a capability class is placed under Function (obo:BFO_0000034) with no CD6 justification record (CAP-09)." ;
        sh:prefixes s05:prefixes ;
        sh:select """SELECT $this WHERE {
          $this rdfs:subClassOf+ obo:BFO_0000034 . }""" ] ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "S05-C6: a capability class is declared disjoint from Function (obo:BFO_0000034), which CAP-09 forbids." ;
        sh:prefixes s05:prefixes ;
        sh:select """SELECT $this WHERE {
          { $this owl:disjointWith obo:BFO_0000034 }
          UNION { obo:BFO_0000034 owl:disjointWith $this } }""" ] ;

    # S05-C7, CAP-30: no only restriction is reviewed in this tranche.
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "S05-C7: a capability class has an only restriction with no CAP-30 exhaustiveness review record." ;
        sh:prefixes s05:prefixes ;
        sh:select """SELECT $this WHERE {
          $this rdfs:subClassOf ?r .
          ?r owl:allValuesFrom ?filler . }""" ] .
