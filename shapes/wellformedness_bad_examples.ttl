@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix bco:  <https://fandaws.com/ontology/bco#> .
@prefix bcom: <https://fandaws.com/ontology/bco-metamodel#> .
@prefix bcoc: <https://fandaws.com/ontology/bco-catalog#> .
@prefix bcos: <https://fandaws.com/ontology/bco-sources#> .

# Graphs built to break wellformedness_shapes.ttl.
#
# Loaded ALONE, so each case states everything it needs. The terms use
# the authored namespaces deliberately -- classes in bco#, concepts in
# bco-metamodel# and bco-catalog# -- because the shapes' targets filter
# on those strings, and a fixture in some other namespace would leave a
# target selecting nothing while every constraint reported success, which
# is the failure mode the shape file's own comment warns about. Each of
# the three namespaces has at least one case that fires, so the
# stale-filter demonstration in tests/test_namespace.py has something to
# lose in each.
#
# The positive controls are not decoration. A fixture where every case
# violates cannot show that a constraint discriminates, and the
# multilingual pair below is the specific false positive that sh:maxCount
# would have produced.

# -- W1: no label -----------------------------------------------------

bco:FixtureUnlabelled a owl:Class ;
    skos:definition "Has a definition and no label." .

# -- W2: no definition ------------------------------------------------

bco:FixtureUndefined a owl:Class ;
    rdfs:label "Has a label and no definition." .

# -- W3: two labels, same language (both untagged) --------------------
#
# This is the shape of the drift ARO found: 6 terms in its APQC corpus
# looked like this, because two slices inlined a term and the copies moved.

bco:FixtureDriftedLabel a owl:Class ;
    rdfs:label "Compliance Policy" , "Compliance Policy and Procedure" ;
    skos:definition "One term, two names, no way to tell which is meant." .

# -- W4: two definitions, same language -------------------------------
#
# 51 terms in ARO's APQC corpus looked like this.

bco:FixtureDriftedDefinition a owl:Class ;
    rdfs:label "Drifted definition" ;
    skos:definition
        "An Act of Prediction in which an Agent extrapolates from historical data." ,
        "An Act of Prediction in which an Agent examines present information." .

# -- W5: two labels tagged the same language --------------------------
#
# Same defect as W3 with the tag written out, so the rule is not passing
# only because both values happen to be untagged.

bco:FixtureDriftedTaggedLabel a owl:Class ;
    rdfs:label "First name"@en , "Second name"@en ;
    skos:definition "Two English labels."@en .

# -- positive controls: these must NOT violate ------------------------

# Multilingual. The reason the drift rules are SPARQL rather than
# sh:maxCount 1, which would reject this.
bco:FixtureMultilingual a owl:Class ;
    rdfs:label "Demand Forecast"@en , "Prevision de la demande"@fr ;
    skos:definition "A forecast of demand."@en , "Une prevision de la demande."@fr .

# The ordinary case.
bco:FixtureWellFormed a owl:Class ;
    rdfs:label "Well formed" ;
    skos:definition "One label, one definition, nothing to report." .

# A term carrying the same value twice is not drift -- an RDF graph is a
# set, so the duplicate collapses on parse and there is nothing to find.
# Here so that the rule is known to be about disagreement rather than
# about counting triples.
bco:FixtureRepeatedValue a owl:Class ;
    rdfs:label "Repeated" , "Repeated" ;
    skos:definition "Said twice, identically." , "Said twice, identically." .

# -- SKOS concepts ----------------------------------------------------
#
# A catalog concept is a different kind of thing from a class: it is
# labelled with skos:prefLabel and carries no rdfs:label. Asking it for
# one was the first draft of the shape file and produced 3,842 findings
# that were the catalog being told to look like a class. These cases
# exist so that the split is exercised rather than asserted.
#
# Since P4 the concept population is ADR-003 D1's: concepts in
# bco-metamodel# and bco-catalog#, each case in one of the two so that
# both filters are shown to select.

# W6: a metamodel concept with no prefLabel.
bcom:FixtureConceptUnlabelled a skos:Concept ;
    skos:inScheme bcom:MetamodelScheme .

# W7: a catalog concept with two prefLabels in the same language.
bcoc:FixtureConceptDrifted a skos:Concept ;
    skos:prefLabel "Develop Vision and Strategy" , "Develop Vision" .

# W8: a catalog concept with no prefLabel -- W6 in the other namespace.
bcoc:FixtureCatalogConceptUnlabelled a skos:Concept ;
    skos:inScheme bcoc:CapabilityCatalogScheme .

# W9: a metamodel concept with two English prefLabels -- W7 in the other
# namespace, with the tag written out.
bcom:FixtureMetamodelConceptDrifted a skos:Concept ;
    skos:prefLabel "Capability Map"@en , "Capability Mapping"@en .

# positive controls: the ordinary concept in each namespace. Neither
# carries an rdfs:label, and neither must be reported for lacking one.
bcom:FixtureConceptWellFormed a skos:Concept ;
    skos:prefLabel "Capability Assessment"@en ;
    skos:inScheme bcom:MetamodelScheme .

bcoc:FixtureConceptWellFormed a skos:Concept ;
    skos:prefLabel "Manage Customer Service"@en ;
    skos:inScheme bcoc:CapabilityCatalogScheme .

# positive control: outside the population. Sources are not SKOS concepts
# (ADR-003 D8), so the concept filter must not reach bco-sources# even
# when something there is typed as one; this has no prefLabel and must
# NOT be reported by these shapes. (vocabulary_shapes.ttl rejects it as a
# malformed source record, which is the other rung's business.)
bcos:FixtureNotInThePopulation a skos:Concept .

# A concept in the ontology namespace is outside the population too: D1
# puts classes in bco#, not concepts. Unlabelled, and must NOT be
# reported -- the filter is on the two vocabulary namespaces only.
bco:FixtureConceptOutsideThePopulation a skos:Concept .
