cco:ont00001808 cco:ont00001754 "http://purl.obolibrary.org/obo/IAO_0000136" .
cco:ont00001808 cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .
cco:ont00001808 rdf:type owl:ObjectProperty .
cco:ont00001808 rdfs:domain cco:ont00000958 .
cco:ont00001808 rdfs:label "is about"@en .
cco:ont00001808 rdfs:range obo:BFO_0000001 .
cco:ont00001808 skos:definition "A primitive relationship between an Information Content Entity and some Entity."@en .

cco:ont00001809 cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI .
cco:ont00001809 owl:inverseOf cco:ont00001836 .
cco:ont00001809 rdf:type owl:ObjectProperty .
cco:ont00001809 rdfs:label "inheres in aggregate"@en .
cco:ont00001809 rdfs:range obo:BFO_0000027 .
cco:ont00001809 skos:definition "x inheres_in_aggregate y iff x is an instance of Specifically Dependent Continuant and y is an instance of Object Aggregate and z is an instance of Object, such that z bearer_of x, and all other members of y are bearers of a unique instance of the same type as x."@en .

cco:ont00001811 cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .
cco:ont00001811 owl:inverseOf cco:ont00001963 .
cco:ont00001811 rdf:type owl:ObjectProperty .
cco:ont00001811 rdfs:domain cco:ont00001010 .
cco:ont00001811 rdfs:label "is a ordinal measurement of"@en .
cco:ont00001811 rdfs:subPropertyOf cco:ont00001966 .
cco:ont00001811 skos:definition "x is_a_ordinal_measurement_of y iff x is an instance of Information Content Entity and y is an instance of Entity, such that x describes some attribute of y relative to a scale ordered by rank."@en .

cco:ont00001836 cco:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI .
cco:ont00001836 rdf:type owl:ObjectProperty .
cco:ont00001836 rdfs:domain obo:BFO_0000027 .
cco:ont00001836 rdfs:label "aggregate bearer of"@en .
cco:ont00001836 skos:definition "x aggregate_bearer_of y iff x is an instance of Object Aggregate and y is an instance of Specifically Dependent Continuant and z is an instance of Object, such that z bearer of y, and all other members of x are bearers of a unique instance of the same type as y."@en .

cco:ont00001880 cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .
cco:ont00001880 owl:inverseOf cco:ont00001898 .
cco:ont00001880 rdf:type owl:ObjectProperty .
cco:ont00001880 rdfs:domain cco:ont00001379 .
cco:ont00001880 rdfs:label "capability of aggregate"@en .
cco:ont00001880 rdfs:range cco:ont00000300 .
cco:ont00001880 rdfs:subPropertyOf cco:ont00001809 .
cco:ont00001880 skos:definition "x capability_of_aggregate y iff y is an instance of Object Aggregate and x is an instance of Agent Capability, such that x inheres in aggregate y."@en .

cco:ont00001889 cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .
cco:ont00001889 owl:inverseOf cco:ont00001954 .
cco:ont00001889 rdf:type owl:ObjectProperty .
cco:ont00001889 rdfs:domain cco:ont00001379 .
cco:ont00001889 rdfs:label "capability of"@en .
cco:ont00001889 rdfs:range cco:ont00001017 .
cco:ont00001889 rdfs:subPropertyOf obo:BFO_0000197 .
cco:ont00001889 skos:definition "x capability_of y iff y is an instance of Agent and x is an instance of Agent Capability, such that x inheres in y."@en .

cco:ont00001898 cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .
cco:ont00001898 rdf:type owl:ObjectProperty .
cco:ont00001898 rdfs:domain cco:ont00000300 .
cco:ont00001898 rdfs:label "aggregate has capability"@en .
cco:ont00001898 rdfs:range cco:ont00001379 .
cco:ont00001898 rdfs:subPropertyOf cco:ont00001836 .
cco:ont00001898 skos:definition "x aggregate_has_capability y iff x is an instance of Object Aggregate and y is an instance of Agent Capability, such that x is aggregate bearer of y."@en .

cco:ont00001904 cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .
cco:ont00001904 owl:inverseOf cco:ont00001966 .
cco:ont00001904 rdf:type owl:ObjectProperty .
cco:ont00001904 rdfs:label "is measured by"@en .
cco:ont00001904 rdfs:range cco:ont00001163 .
cco:ont00001904 rdfs:subPropertyOf cco:ont00001917 .
cco:ont00001904 skos:definition "y is_measured_by x iff x is an instance of Information Content Entity and y is an instance of Entity, such that x describes some attribute of y relative to some scale or classification scheme."@en .

cco:ont00001910 cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .
cco:ont00001910 owl:inverseOf cco:ont00001998 .
cco:ont00001910 rdf:type owl:ObjectProperty .
cco:ont00001910 rdfs:domain cco:ont00001324 .
cco:ont00001910 rdfs:label "permits"@en .
cco:ont00001910 rdfs:range obo:BFO_0000015 .
cco:ont00001910 rdfs:subPropertyOf cco:ont00001942 .
cco:ont00001910 skos:definition "x permits y at t iff: x is an instance of Process Regulation at time t, and y is an instance of Process at time t, and x prescribes that y may occur."@en .
cco:ont00001910 skos:scopeNote "Given a stronger temporal interpretation, this property may be asymmetric and irreflexive. For more info please refer to https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/temporal%20extensions."@en .

cco:ont00001917 cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .
cco:ont00001917 owl:inverseOf cco:ont00001982 .
cco:ont00001917 rdf:type owl:ObjectProperty .
cco:ont00001917 rdfs:label "described by"@en .
cco:ont00001917 rdfs:range cco:ont00000853 .
cco:ont00001917 rdfs:subPropertyOf cco:ont00001801 .
cco:ont00001917 skos:definition "x described_by y iff y is an instance of Information Content Entity, and x is an instance of Entity, such that y is about the characteristics by which y can be recognized or visualized."@en .

cco:ont00001920 cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .
cco:ont00001920 owl:inverseOf cco:ont00001942 .
cco:ont00001920 rdf:type owl:ObjectProperty .
cco:ont00001920 rdfs:label "prescribed by"@en .
cco:ont00001920 rdfs:range cco:ont00000965 .
cco:ont00001920 rdfs:subPropertyOf cco:ont00001801 .
cco:ont00001920 skos:definition "x prescribed_by y iff y is an instance of Information Content Entity and x is an instance of Entity, such that y serves as a rule or guide for x if x is an Occurrent, or y serves as a model for x if x is a Continuant."@en .

cco:ont00001942 cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .
cco:ont00001942 rdf:type owl:ObjectProperty .
cco:ont00001942 rdfs:domain cco:ont00000965 .
cco:ont00001942 rdfs:label "prescribes"@en .
cco:ont00001942 rdfs:subPropertyOf cco:ont00001808 .
cco:ont00001942 skos:definition "x prescribes y iff x is an instance of Information Content Entity and y is an instance of Entity, such that x serves as a rule or guide for y if y an Occurrent, or x serves as a model for y if y is a Continuant."@en .
cco:ont00001942 skos:example "A blueprint prescribes some artifact or facility by being a model for it." .
cco:ont00001942 skos:example "A professional code of conduct prescribes some realizations of a profession (role) by giving rules for how the bearer should act in those realizations." .
cco:ont00001942 skos:example "An operations plan prescribes an operation by enumerating the tasks that need to be performed in order to achieve the objectives of the operation." .

cco:ont00001954 cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .
cco:ont00001954 rdf:type owl:ObjectProperty .
cco:ont00001954 rdfs:domain cco:ont00001017 .
cco:ont00001954 rdfs:label "has capability"@en .
cco:ont00001954 rdfs:range cco:ont00001379 .
cco:ont00001954 rdfs:subPropertyOf obo:BFO_0000196 .
cco:ont00001954 skos:definition "x has_capability y iff x is an instance of Agent and y is an instance of Agent Capability, such that x bearer of y."@en .

cco:ont00001963 cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .
cco:ont00001963 rdf:type owl:ObjectProperty .
cco:ont00001963 rdfs:label "is measured by ordinal"@en .
cco:ont00001963 rdfs:range cco:ont00001010 .
cco:ont00001963 rdfs:subPropertyOf cco:ont00001904 .
cco:ont00001963 skos:definition "y is_measured_by_ordinal x iff x is an instance of Information Content Entity and y is an instance of Entity, such that x describes some attribute of y relative to a scale ordered by rank."@en .

cco:ont00001966 cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .
cco:ont00001966 rdf:type owl:ObjectProperty .
cco:ont00001966 rdfs:comment "This object property, as well as all of its children are typified as functional properties. This means that for instances x, y, and z if x is a measurement of y and x is a measurement of z, then y = z."@en .
cco:ont00001966 rdfs:domain cco:ont00001163 .
cco:ont00001966 rdfs:label "is a measurement of"@en .
cco:ont00001966 rdfs:subPropertyOf cco:ont00001982 .
cco:ont00001966 skos:definition "x is_a_measurement_of y iff x is an instance of Information Content Entity and y is an instance of Entity, such that x describes some attribute of y relative to some scale or classification scheme."@en .
cco:ont00001966 skos:scopeNote "Given a stronger temporal interpretation, this property may be functional. For more info please refer to https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/temporal%20extensions."@en .

cco:ont00001982 cco:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .
cco:ont00001982 rdf:type owl:ObjectProperty .
cco:ont00001982 rdfs:comment "It is possible that this relation should be a functional property, that is for all x, y, z if x describes y and x describes z then y = z. For example, if a financial report x describes the quarterly results of a company y and that same financial report describes the quarterly results of a company z, then it should be inferred that companies y and z are the same. We refrained from classifying the relation as a functional property on the concern that descriptions are multifaceted and so consequently it may be that the same report would contain descriptions of multiple entities."@en .
cco:ont00001982 rdfs:domain cco:ont00000853 .
cco:ont00001982 rdfs:label "describes"@en .
cco:ont00001982 rdfs:subPropertyOf cco:ont00001808 .
cco:ont00001982 skos:definition "x describes y iff x is an instance of Information Content Entity, and y is an instance of Entity, such that x is about the characteristics by which y can be recognized or visualized."@en .
cco:ont00001982 skos:example "the content of a newspaper article describes some current event" .
cco:ont00001982 skos:example "the content of a visitor's log describes some facility visit" .
cco:ont00001982 skos:example "the content of an accident report describes some accident" .

cco:ont00001998 cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .
cco:ont00001998 rdf:type owl:ObjectProperty .
cco:ont00001998 rdfs:domain obo:BFO_0000015 .
cco:ont00001998 rdfs:label "is permitted by"@en .
cco:ont00001998 rdfs:range cco:ont00001324 .
cco:ont00001998 rdfs:subPropertyOf cco:ont00001920 .
cco:ont00001998 skos:definition "y is_permitted_by x at t iff: x is an instance of Process Regulation at time t, and y is an instance of Process at time t, and x prescribes that y may occur."@en .
cco:ont00001998 skos:scopeNote "Given a stronger temporal interpretation, this property may be asymmetric and irreflexive. For more info please refer to https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/temporal%20extensions."@en .

dcterms:license rdf:type owl:AnnotationProperty .

dcterms:source rdf:type owl:AnnotationProperty .

obo:BFO_0000127 skos:scopeNote "Users that require more sophisticated representations of time are encouraged to import a temporal extension of BFO-Core provided by the BFO development team. See documentation for guidance: <https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/profiles/temporal%20extensions>"@en .

