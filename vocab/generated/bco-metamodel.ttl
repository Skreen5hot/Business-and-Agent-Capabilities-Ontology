bcom:source-7fbc3e395fbf7b5de65a40d2ae8efb38bd86a1bbd43695fb0d7bf146cb9ae03a bco:locator "BACM 1.1, section 7.3.2.7 (Capability is identified by the Outcome a business can produce, not by how it is produced)" .
bcom:source-7fbc3e395fbf7b5de65a40d2ae8efb38bd86a1bbd43695fb0d7bf146cb9ae03a bco:relation "consistent-with" .
